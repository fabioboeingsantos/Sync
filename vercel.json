{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/estoque",
      "destination": "/estoque/",
      "permanent": true
    },
    {
      "source": "/equipe",
      "destination": "/equipe/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:rota*",
      "destination": "/api/index?__rota=:rota*"
    }
  ]
}
