# Configuração do Supabase usada pelas funções Node do VisionChef.
# Copie para .env no ambiente local e cadastre como variáveis privadas na Vercel.
VISIONCHEF_SUPABASE_URL=
VISIONCHEF_SUPABASE_PUBLISHABLE_KEY=

# Configuração do backend Node servido por funções Vercel; o frontend não recebe estes valores.
# Gere um segredo próprio por ambiente. Nunca copie este marcador para um ambiente ativo.
JWT_SECRET_KEY=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
JWT_COOKIE_NAME=access_token
# false somente no desenvolvimento HTTP local; use true em produção HTTPS.
JWT_COOKIE_SECURE=false
# Proteções contra abuso no login e no cadastro.
AUTH_LOGIN_LIMIT=5
AUTH_SIGNUP_LIMIT=3
AUTH_RATE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=900
HTTP_PORT=8080
